# ============================================================
#  4 & | 2 — Configurazione ambiente
#  Copia questo file in ".env" e personalizza i valori.
# ============================================================

# Porta del server (solo esecuzione locale)
PORT=3000

# Ambiente: development | production
NODE_ENV=development

# Segreto per la firma dei JWT (CAMBIALO in produzione con una stringa lunga e casuale!)
JWT_SECRET=cambiami-con-una-stringa-lunga-e-casuale
JWT_EXPIRES_IN=7d

# --- Database (libSQL / Turso) ---
# Locale: file SQLite embedded (default). Produzione: URL Turso libsql://...
DATABASE_URL=file:server/database/quattroedue.db
# In produzione:
# DATABASE_URL=libsql://il-tuo-db.turso.io
DATABASE_AUTH_TOKEN=

# --- Upload immagini (Vercel Blob) ---
# Locale: lascia vuoto (i file vanno in public/uploads).
# Produzione: token del Blob store Vercel.
BLOB_READ_WRITE_TOKEN=

# --- Amministratori ---
# Email (separate da virgola) promosse ad admin all'avvio: sbloccano /admin.html
# con i numeri dell'app (utenti, contenuti, segnalazioni). Sola lettura.
ADMIN_EMAILS=

# URL base del frontend (opzionale; su Vercel same-origin)
CLIENT_URL=http://localhost:3000

# --- Accesso con Google (Google Identity Services) ---
# Crea un OAuth 2.0 Client ID di tipo "Web application" su
# https://console.cloud.google.com/apis/credentials e aggiungi agli
# "Authorized JavaScript origins" l'URL dell'app (es. http://localhost:3000
# e https://il-tuo-dominio.it). Se lasci vuoto, il pulsante
# "Continua con Google" non viene mostrato.
GOOGLE_CLIENT_ID=

# --- Mappe ---
# Stile MapLibre. Di default usiamo tiles raster CARTO dark (gratis, senza chiave).
# Per usare MapTiler/Stadia inserisci qui l'URL di uno style JSON e la tua chiave.
MAP_STYLE_URL=
MAP_TILE_KEY=

# --- Segnalazioni di bug (email) ---
# Il tasto "Segnala un bug" (Impostazioni → Assistenza) salva sempre la
# segnalazione a database; per riceverla anche per email serve una chiave API
# Resend (https://resend.com — piano gratuito). Senza chiave l'invio è
# semplicemente disattivato.
RESEND_API_KEY=
# Mittente: con un dominio verificato su Resend usa un indirizzo di quel
# dominio; per provare subito va bene onboarding@resend.dev.
MAIL_FROM=4 e 2 <onboarding@resend.dev>
# Destinatario delle segnalazioni.
BUG_REPORT_TO=youfusion945@gmail.com
